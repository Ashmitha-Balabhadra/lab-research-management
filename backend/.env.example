# =============================================================
#  Backend Environment Variables
#  For LOCAL DEVELOPMENT only — do NOT commit .env files
#  1. Copy this file to backend/.env
#  2. Fill in your real values
# =============================================================

# ── Server ────────────────────────────────────────────────────
# Render injects PORT automatically — leave unset locally
# PORT=8080

# ── Database (PostgreSQL / Render / Neon / Supabase) ──────────
# LOCAL default (used when DB_URL is not set):
#   jdbc:postgresql://localhost:5432/lab_resource_utilization
#
# RENDER MANAGED POSTGRES (Auto-injected as DATABASE_URL on Render):
#   DATABASE_URL=postgresql://user:password@host/database
#
# Or manually via DB_URL:
#   DB_URL=jdbc:postgresql://<host>:<port>/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/lab_resource_utilization
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── JWT ───────────────────────────────────────────────────────
# Use a long random hex string in production (min 64 chars)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://<your-frontend>.onrender.com

# ── Cloudinary (Image Uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Spring Mail (optional) ────────────────────────────────────
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
