# =============================================================
#  Backend Environment Variables
#  For LOCAL DEVELOPMENT only — do NOT commit .env files
#  1. Copy this file to backend/.env
#  2. Fill in your real values
# =============================================================

# ── Server ────────────────────────────────────────────────────
# Render injects PORT automatically — leave unset locally
# PORT=8080

# ── Database (MySQL / Aiven) ───────────────────────────────────
# LOCAL default (used when DB_URL is not set):
#   jdbc:mysql://localhost:3306/lab_resource_utilization?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
#
# AIVEN / RENDER format:
#   jdbc:mysql://<host>:<port>/<dbname>?useSSL=true&requireSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=<your-jdbc-url>
DB_USERNAME=<your-db-username>
DB_PASSWORD=<your-db-password>

# ── JWT ───────────────────────────────────────────────────────
# Use a long random hex string in production (min 64 chars)
JWT_SECRET=<your-64-char-hex-secret>
JWT_EXPIRATION_MS=86400000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://<your-frontend>.onrender.com

# ── Cloudinary (Image Uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── Spring Mail (optional) ────────────────────────────────────
# Uncomment and fill in if email functionality is needed
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
